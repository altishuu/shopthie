{
  "name": "shopthie",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/unit/*.test.ts",
    "test:e2e": "npm run build && playwright test",
    "test:report": "playwright show-report",
    "test:visual": "node scripts/verify-phase4.mjs",
    "test:visual:motion": "node scripts/verify-phase3.mjs",
    "test:storytelling": "playwright test tests/e2e/storytelling.spec.ts",
    "test:visual:commerce": "node scripts/verify-phase2.mjs",
    "test:motion": "playwright test tests/e2e/motion.spec.ts tests/e2e/motion-regressions.spec.ts tests/e2e/first-paint.spec.ts tests/e2e/animation-continuity.spec.ts",
    "test:dev:motion": "node scripts/verify-phase3-dev.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"scripts/*.mjs\" playwright.config.ts",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"scripts/*.mjs\" playwright.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "lucide-react": "^1.62.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
