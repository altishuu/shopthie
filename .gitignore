# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editors / logs / temp
.vscode/
.idea/
*.log
*.tmp
*.swp
Thumbs.db

# playwright
/playwright/.cache/
/blob-report/

# generated verification output (regenerated by scripts/verify-phase*.mjs)
/docs/screenshots/
/docs/phase-2-browser-results.json
