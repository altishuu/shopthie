# Optional backend config: public storefront still works without it; account flows fail closed.
# Never use a secret/service-role key in a NEXT_PUBLIC_* variable.
# Use a modern publishable key; legacy anon/service JWT keys are not accepted here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only cookie origin. Default is Secure cookies; HTTP is allowed ONLY for an
# explicitly configured loopback origin, e.g. http://127.0.0.1:3100 for local preview.
# Use your exact HTTPS app origin when deploying. No cookie Domain is set.
SHOPTHIE_APP_ORIGIN=

# Public signup is intentionally closed while age/teen safeguards and email
# verification/recovery delivery remain unresolved. There is no env override.
# Native provider settings must also keep signup/anonymous users disabled.
# No SMTP sender, Stripe or privileged/service credentials are configured.
